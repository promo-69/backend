meta {
  name: Pay Order
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  [
    {
      "payment_method": 5,
      "amount": {{orderTotalBase}},
      "currency": 1
    }
  ]
}

vars:pre-request {
  refNumber: 25898019776310567804
  orderTotalBase: 100
}

script:pre-request {
  bru.setVar("refNumber", "TX-" + Math.floor(Math.random() * 1000000000));
}

script:post-response {
  if (res.status === 200 || res.status === 202) {
    const data = res.getBody();
    // NOTA: El endpoint ahora es asíncrono.
    // El qr_code no se devuelve en la respuesta HTTP.
    // Debes escuchar el evento 'payment_completed' vía WebSockets.
  }
}
