meta {
  name: Pay Order
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  [
    {
      "payment_method": 5,
      "amount": {{orderTotalBase}},
      "currency": 1
    }
  ]
}

vars:pre-request {
  refNumber: 25898019776310567804
  orderTotalBase: 100
}

script:pre-request {
  bru.setVar("refNumber", "TX-" + Math.floor(Math.random() * 1000000000));
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const data = res.getBody();
    if (data.data && data.data.qr_code) {
      bru.setEnvVar("orderQrCode", data.data.qr_code);
    }
  }
}
