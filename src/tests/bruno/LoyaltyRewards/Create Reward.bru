meta {
  name: Create Reward (Blank Ticket)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/loyalty-rewards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Boleto en blanco",
    "description": "Pase canjeable por cualquier función. Válido 30 días.",
    "pointsCost": 3000,
    "requiredLoyaltyLevel": 3,
    "rewardType": "BLANK_TICKET",
    "cinema": {{cinemaId}}
  }
}

tests {
  test("crea el premio", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data).to.have.property("id");
  });
}

docs {
  cinema solo es necesario si el token es de SUPER_ADMIN. Un empleado usa su sucursal anclada.
}
