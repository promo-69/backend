meta {
  name: Verify My Security
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/users/me/security/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "password": "{{currentPassword}}"
  }
}

vars:pre-request {
  currentPassword: Password123*
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data && data.data && data.data.securityChangeToken) {
      bru.setEnvVar('securityChangeToken', data.data.securityChangeToken);
    }
  }
}
