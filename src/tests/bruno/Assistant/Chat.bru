meta {
  name: Assistant Chat
  type: http
  seq: …
}

post {
  url: {{baseUrl}}/assistant/chat
  body: json
  auth: none
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}

body:json {
  {
    "message": "Recomiéndame películas de acción para este fin de semana",
    "cinemaId": 1
  }
}
