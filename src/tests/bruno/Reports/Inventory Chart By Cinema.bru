meta {
  name: Inventory Chart By Cinema
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/reports/cinemas/{{cinemaId}}/inventory/chart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Datos normalizados para gráfico de inventario de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-ALL
}
