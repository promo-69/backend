meta {
  name: Export Sales By Cinema
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/reports/sales/export?format=csv&from={{fromDate}}&to={{toDate}}&channel=all&cinemaId={{cinemaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  format: csv
  from: {{fromDate}}
  to: {{toDate}}
  channel: all
  cinemaId: {{cinemaId}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Exporta reporte de ventas de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-EXPORT
}
