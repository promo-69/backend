meta {
  name: Rentals Chart By Cinema
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/reports/cinemas/{{cinemaId}}/rentals/chart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Datos normalizados para gráfico de alquileres de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-ALL
}
