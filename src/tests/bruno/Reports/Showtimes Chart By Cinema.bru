meta {
  name: Showtimes Chart By Cinema
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/reports/showtimes/chart?from={{fromDate}}&to={{toDate}}&cinemaId={{cinemaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
  cinemaId: {{cinemaId}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Datos normalizados para gráfico de funciones de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-CHARTS
}
