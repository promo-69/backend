meta {
  name: Sales Chart By Cinema
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/reports/sales/chart?from={{fromDate}}&to={{toDate}}&groupBy=week&channel=all&cinemaId={{cinemaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
  groupBy: week
  channel: all
  cinemaId: {{cinemaId}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Datos normalizados para gráfico de ventas de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-CHARTS
}
