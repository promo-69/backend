meta {
  name: Sales Chart By Cinema
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/reports/cinemas/{{cinemaId}}/sales/chart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
  groupBy: week
  channel: all
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Datos normalizados para gráfico de ventas de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-ALL
}
