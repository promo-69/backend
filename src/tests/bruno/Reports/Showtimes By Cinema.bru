meta {
  name: Showtimes By Cinema
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/reports/cinemas/{{cinemaId}}/showtimes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Reporte de funciones de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-ALL
}
