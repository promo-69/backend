meta {
  name: Events Chart By Cinema
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/reports/events/chart?from={{fromDate}}&to={{toDate}}&cinemaId={{cinemaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  from: {{fromDate}}
  to: {{toDate}}
  cinemaId: {{cinemaId}}
}

vars:pre-request {
  cinemaId: 1
}

docs {
  Datos normalizados para gráfico de eventos de una sucursal específica.
  Permiso: CRUD:READ:REPORTS-CHARTS
}
