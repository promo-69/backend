meta {
  name: Update Bank Account
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/payments/bank-accounts/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "payment_details": {
      "account_number": "02019999999999999999"
    },
    "api_key": "updated-secret-token"
  }
}
