meta {
  name: Update Cinema (Explicit)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/cinemas/{{testCinemaId}}
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  name: Test Cinema Bruno Updated
  address: 456 Updated Ave
  openingTime: 10:00
  closingTime: 22:00
  ~image: @file(/path/to/image.jpg)
  ~facadeUrl: null
}

vars:pre-request {
  testCinemaId: 1
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
