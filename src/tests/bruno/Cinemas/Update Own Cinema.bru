meta {
  name: Update Own Cinema
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/cinemas
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  name: My Cinema Updated
  address: 789 Manager Ave
  openingTime: 10:00
  closingTime: 22:30
  ~image: @file(/path/to/image.jpg)
  ~facadeUrl: null
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
