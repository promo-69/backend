meta {
  name: Get Movie Showtimes Grouped by Cinema (with date)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/showtimes/by-content/movie/{{movieId}}?date={{date}}
  body: none
  auth: none
}

vars:pre-request {
  movieId: 1
  date: 2026-06-15
}

docs {
  Filtra las funciones de la película para una fecha específica.
}
