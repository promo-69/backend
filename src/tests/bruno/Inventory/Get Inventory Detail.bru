meta {
  name: Get Inventory Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/inventory/{{inventoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  inventoryId: 1
}

docs {
  Obtiene el detalle completo de un registro de inventario,
  incluyendo el producto, stock actual, costo unitario y el historial de movimientos.
}
