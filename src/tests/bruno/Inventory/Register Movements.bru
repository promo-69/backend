meta {
  name: Register Movements (Entry)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/inventory/{{inventoryId}}/movements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  [
    {
      "operationType": {{opTypeIn}},
      "quantity": 100,
      "unit_cost": 5.50,
      "remarks": "Compra a proveedor"
    }
  ]
}

vars:pre-request {
  inventoryId: 1
  opTypeIn: 3
}

docs {
  Registra un movimiento de ENTRADA (incrementa stock).
  `operationType` debe corresponder a un tipo de operación con `is_increment = true`.
  `unit_cost` es opcional; si no se envía, se mantiene el costo promedio actual.
}
