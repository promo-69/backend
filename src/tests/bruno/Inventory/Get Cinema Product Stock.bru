meta {
  name: Get Cinema Product Stock
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/cinemas/{{cinemaId}}/inventory/products/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  cinemaId: 1
  productId: 1
}

docs {
  Stock de un producto específico en una sucursal concreta.
}
